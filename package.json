{
  "name": "agent-standup",
  "displayName": "Agent Standup: Claude Code & Codex Agent Monitor",
  "description": "%extension.description%",
  "version": "1.42.0",
  "publisher": "DoubleGeste",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization",
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "start": "node server.js",
    "package": "npx --yes @vscode/vsce package --allow-missing-repository --skip-license",
    "landing": "node scripts/build-landing.js",
    "website": "node scripts/build-website.js",
    "brand": "node scripts/build-brand.js",
    "plugin": "node scripts/sync-plugin.js",
    "capture": "node scripts/capture-demo.js all",
    "stats": "node scripts/stats.js",
    "promo": "node scripts/capture-promo.js",
    "promo:codex": "node scripts/capture-codex.js",
    "promo:vibe": "node scripts/capture-vibe.js",
    "story": "node scripts/make-story.js",
    "i18n": "node scripts/i18n.js check && node scripts/site-locales.js",
    "i18n:extract": "node scripts/i18n.js extract",
    "build:cli": "node scripts/build-cli.js",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "puppeteer-core": "^25.13.0"
  },
  "contributes": {
    "commands": [
      {
        "command": "agentStandup.open",
        "title": "%command.open.title%"
      },
      {
        "command": "agentStandup.openInBrowser",
        "title": "%command.openInBrowser.title%"
      },
      {
        "command": "agentStandup.focus",
        "title": "%command.focus.title%"
      },
      {
        "command": "agentStandup.openCharacters",
        "title": "%command.openCharacters.title%"
      }
    ],
    "configuration": {
      "title": "Agent Standup",
      "properties": {
        "agentStandup.port": {
          "type": "number",
          "default": 0,
          "description": "%config.port.description%"
        },
        "agentStandup.autoOpen": {
          "type": "boolean",
          "default": false,
          "description": "%config.autoOpen.description%"
        },
        "agentStandup.onlyThisWorkspace": {
          "type": "boolean",
          "default": true,
          "description": "%config.onlyThisWorkspace.description%"
        },
        "agentStandup.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.description%"
        },
        "agentStandup.notifyNeedsYou": {
          "type": "boolean",
          "default": true,
          "description": "%config.notifyNeedsYou.description%"
        },
        "agentStandup.shareUsage": {
          "type": "boolean",
          "default": false,
          "description": "%config.shareUsage.description%"
        },
        "agentStandup.codex": {
          "type": "boolean",
          "default": true,
          "description": "%config.codex.description%"
        },
        "agentStandup.vibe": {
          "type": "boolean",
          "default": true,
          "description": "%config.vibe.description%"
        },
        "agentStandup.claudePath": {
          "type": "string",
          "default": "",
          "description": "%config.claudePath.description%"
        },
        "agentStandup.charactersPath": {
          "type": "string",
          "default": "",
          "description": "%config.charactersPath.description%"
        },
        "agentStandup.leadName": {
          "type": "string",
          "default": "",
          "maxLength": 24,
          "description": "%config.leadName.description%"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentStandup",
          "title": "Agent Standup",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentStandup": [
        {
          "type": "webview",
          "id": "agentStandup.view",
          "name": "%view.name%"
        }
      ]
    }
  },
  "icon": "media/icon.png",
  "keywords": [
    "claude code",
    "claude code agents",
    "claude code monitor",
    "claude code dashboard",
    "claude code sessions",
    "claude",
    "claude agent",
    "codex",
    "openai codex",
    "codex cli",
    "mistral",
    "mistral vibe",
    "cowork",
    "agents",
    "ai agents",
    "subagents",
    "sub-agents",
    "multi-agent",
    "parallel agents",
    "coding agent",
    "agentic",
    "agent monitor",
    "agent dashboard",
    "monitor",
    "dashboard",
    "sessions",
    "token usage",
    "observability",
    "notifications",
    "standup"
  ],
  "galleryBanner": {
    "color": "#12131a",
    "theme": "dark"
  },
  "qna": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/Atoll92/agent-standup.git"
  },
  "homepage": "https://agent-standup.com",
  "bugs": {
    "url": "https://github.com/Atoll92/agent-standup/issues"
  },
  "sponsor": {
    "url": "https://www.buymeacoffee.com/bored_dev_and_his_robots"
  },
  "l10n": "./l10n"
}
